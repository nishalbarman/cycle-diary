rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function isString(value) {
      return value is string;
    }

    function isStringOrNull(value) {
      return value == null || value is string;
    }

    function isBool(value) {
      return value is bool;
    }

    function isIntInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isTimeString(value) {
      // HH:mm
      return value is string
        && value.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isDateString(value) {
      // YYYY-MM-DD
      return value is string
        && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidLog(data) {
      return data.id is string
        && isDateString(data.date)
        && data.isPeriod is bool
        && data.symptoms is list
        && (
          !('flow' in data) ||
          data.flow == null ||
          data.flow in ['light', 'medium', 'heavy']
        )
        && (
          !('mood' in data) ||
          data.mood == null ||
          data.mood in [
            'happy', 'calm', 'energetic', 'anxious',
            'sad', 'irritated', 'tired', 'stressed'
          ]
        )
        && (
          !('notes' in data) ||
          data.notes == null ||
          data.notes is string
        );
    }

    function isValidSettings(data) {
      return isIntInRange(data.cycleLength, 18, 45)
        && isIntInRange(data.periodLength, 1, 10)
        && isStringOrNull(data.lastPeriodStart)
        && (data.lastPeriodStart == null || isDateString(data.lastPeriodStart))
        && data.notificationsEnabled is bool
        && isIntInRange(data.notifyBeforeDays, 0, 14)
        && isTimeString(data.notifyTime)
        && data.symptomTracking is bool
        && data.flowTracking is bool
        && data.onboardingComplete is bool;
    }

    // ---------- Rules ----------

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Settings (single doc at meta/settings)
      match /meta/{document=**} {
        allow read, write: if isOwner(uid)
          && isValidSettings(request.resource.data);
      }

      // Logs (one doc per period/symptom entry)
      match /logs/{logId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isValidLog(request.resource.data)
          && request.resource.data.id == logId;

        allow update: if isOwner(uid)
          && isValidLog(request.resource.data)
          && request.resource.data.id == logId;

        allow delete: if isOwner(uid);
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
